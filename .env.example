# NammaTrip AI — Environment Variables Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication Security
# Generate a strong 64-character secret in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=nammatrip_karnataka_heritage_super_secret_jwt_key_2026

# AI Engine Integration (Optional)
# If provided, NammaTrip enhances itineraries with live Gemini 2.5 Flash generations.
# If omitted or unavailable, NammaTrip automatically and gracefully utilizes its built-in
# Curated Karnataka Heritage Engine without interruption.
GEMINI_API_KEY=

# Map & Routing Service Configuration (Optional)
# Defaults to OpenStreetMap Nominatim and project OSRM public driving routing engine.
# Configure custom self-hosted or dedicated endpoints if desired.
# GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
# OSRM_ROUTER_URL=https://router.project-osrm.org

